# Copy to .env; never commit the filled-in file.
ROLE_AI_MODE=local
ROLE_AI_DATABASE_URL=sqlite:///./data/role-ai.db
ROLE_AI_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ROLE_AI_COOKIE_SECURE=false
ROLE_AI_SESSION_TTL_SECONDS=86400
# Local onboarding only. Disable again after creating accounts.
ROLE_AI_REGISTRATION_ENABLED=false
# Optional initial owner. Password must have at least 12 characters.
ROLE_AI_BOOTSTRAP_EMAIL=
ROLE_AI_BOOTSTRAP_PASSWORD=
ROLE_AI_DEFAULT_PROVIDER=ollama
ROLE_AI_OLLAMA_URL=http://127.0.0.1:11434
ROLE_AI_OLLAMA_MODEL=qwen2.5:7b
ROLE_AI_PROVIDER_TIMEOUT_SECONDS=60
# Mock responses are opt-in, labelled, and forbidden in public mode.
ROLE_AI_DEMO_ENABLED=false
# Phase 2: reserved only; no real OpenAI/vLLM calls in this version.
ROLE_AI_VLLM_URL=http://127.0.0.1:8001/v1
ROLE_AI_VLLM_MODEL=
ROLE_AI_OPENAI_ENABLED=false
ROLE_AI_OPENAI_API_KEY=
ROLE_AI_OPENAI_MODEL=
ROLE_AI_OPENCLAW_URL=http://127.0.0.1:18789
ROLE_AI_OPENCLAW_TOKEN=

# Owner-only loopback Gateway. Default off. No tools or paid models.
ROLE_AI_OPENCLAW_ENABLED=false
# Actual Gateway startup configuration: strict JSON, not JSON5.
ROLE_AI_OPENCLAW_CONFIG_PATH=

# OpenAI: opt-in owner-only. Prices must match your selected model's current pricing.
# Zero price/budget blocks paid calls. No pricing is assumed from a ChatGPT subscription.
ROLE_AI_OPENAI_INPUT_USD_PER_MILLION=0
ROLE_AI_OPENAI_OUTPUT_USD_PER_MILLION=0
ROLE_AI_OPENAI_DAILY_BUDGET_USD=0
ROLE_AI_OPENAI_REQUEST_BUDGET_USD=0
ROLE_AI_OPENAI_MAX_OUTPUT_TOKENS=512

# Memory/dataset documents stay outside Git. No complete HF repository downloads.
ROLE_AI_STORAGE_DIR=./data/artifacts
ROLE_AI_ARTIFACT_QUOTA_BYTES=104857600
ROLE_AI_HF_DOWNLOAD_ENABLED=false
ROLE_AI_HF_MAX_SCAN_BYTES=2097152
ROLE_AI_HF_TOKEN=
# Training requires reviewed immutable snapshots and explicit approval.
ROLE_AI_TRAINING_ENABLED=false
ROLE_AI_TRAINING_BASE_MODEL_PATH=
ROLE_AI_TRAINING_BASE_MODEL_REVISION=

# 설치된 로컬 임베딩 모델 이름. 빈 값은 의미 검색 비활성화; 자동 다운로드하지 않음.
ROLE_AI_EMBEDDING_MODEL=
ROLE_AI_EMBEDDING_MIN_SCORE=0.35

# 소유자 승인 Python unittest 실행: 기본 꺼짐. Linux 호스트 직접 실행 전용.
# 이미지를 관리자가 사전 준비하고 실제 RepoDigest로 고정해야 함. 자동 pull/install 없음.
ROLE_AI_CODE_EXECUTION_ENABLED=false
ROLE_AI_CODE_EXECUTION_IMAGE=
ROLE_AI_CODE_EXECUTION_SOCKET=/var/run/docker.sock
ROLE_AI_CODE_EXECUTION_TIMEOUT_SECONDS=10
